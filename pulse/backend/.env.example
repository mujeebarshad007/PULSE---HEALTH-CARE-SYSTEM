# Copy to .env. Never commit .env. All values below are examples only.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://pulse:change-me@localhost:5432/pulse

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Scheduling (single timezone for schedules and slots)
APP_TIMEZONE=Asia/Karachi

# File storage: local | cloud
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_CLOUD_BUCKET=
STORAGE_CLOUD_REGION=
STORAGE_CLOUD_ACCESS_KEY=
STORAGE_CLOUD_SECRET_KEY=

# Payments: mock | gateway
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=PKR
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Seed (first admin account)
SEED_ADMIN_EMAIL=admin@pulse.local
SEED_ADMIN_PASSWORD=change-me
